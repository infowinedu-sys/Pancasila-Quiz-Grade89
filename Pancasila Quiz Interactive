              options: ["Maintaining security is a shared obligation between citizens and the state","Citizens have no role in public safety","Only the police are responsible for security","Rights are more important than obligations"], answer: 0 }
        ];

        const STORAGE_KEY = "pancasilaRacingResults_v1";
        const TIME_PER_Q = 50;

        /* ============================================================
           STATE
           ============================================================ */
        let currentQuestionIdx = 0;
        let score = 0;
        let timer = TIME_PER_Q;
        let timerInterval = null;
        let student = { name: "", class: "" };
        let userAnswers = [];
        let historyReturnTo = "login";

        /* ============================================================
           AUDIO
           ============================================================ */
        let audioCtx = null;
        let muted = false;

        function getAudio() {
            if (!audioCtx) {
                try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
                catch (e) { return null; }
            }
            if (audioCtx.state === "suspended") audioCtx.resume();
            return audioCtx;
        }

        function playTone(freq, duration, type = "sine", delay = 0, vol = 0.15) {
            if (muted) return;
            const ctx = getAudio();
            if (!ctx) return;
            const now = ctx.currentTime + delay;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.linearRampToValueAtTime(vol, now + 0.012);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + duration + 0.05);
        }

        const sfx = {
            correct() { playTone(523, 0.10, "sine", 0, 0.16); playTone(659, 0.10, "sine", 0.08, 0.16); playTone(784, 0.22, "sine", 0.16, 0.18); },
            wrong()   { playTone(220, 0.16, "sawtooth", 0, 0.12); playTone(165, 0.26, "sawtooth", 0.12, 0.12); },
            timeout() { playTone(330, 0.18, "sawtooth", 0, 0.14); playTone(220, 0.32, "sawtooth", 0.16, 0.14); },
            finish()  { playTone(523, 0.15, "sine", 0, 0.16); playTone(659, 0.15, "sine", 0.13, 0.16); playTone(784, 0.15, "sine", 0.26, 0.16); playTone(1047, 0.4, "sine", 0.39, 0.18); },
            warn()    { playTone(880, 0.05, "square", 0, 0.06); },
            click()   { playTone(600, 0.04, "sine", 0, 0.05); }
        };

        /* ============================================================
           START QUIZ
           ============================================================ */
        function startQuiz(e) {
            e.preventDefault();
            getAudio();

            student.name = document.getElementById('studentName').value.trim();
            student.class = document.getElementById('studentClass').value.trim();
            if (!student.name || !student.class) return;

            document.getElementById('headerStudentName').textContent = student.name;
            document.getElementById('headerStudentClass').textContent = "Class: " + student.class;
            document.getElementById('userInfoHeader').classList.remove('hidden');

            document.getElementById('loginScreen').classList.add('hidden');
            document.getElementById('quizScreen').classList.remove('hidden');
            document.getElementById('reportScreen').classList.add('hidden');
            document.getElementById('historyScreen').classList.add('hidden');

            currentQuestionIdx = 0;
            score = 0;
            userAnswers = [];

            updateLiveScore();
            updateCarPosition(false);
            loadQuestion();
        }

        /* ============================================================
           LOAD QUESTION
           ============================================================ */
        function loadQuestion() {
            clearInterval(timerInterval);
            const q = quizData[currentQuestionIdx];

            document.getElementById('chapterBadge').textContent = q.chapter;
            document.getElementById('questionText').textContent = (currentQuestionIdx + 1) + ". " + q.question;
            document.getElementById('questionNum').textContent = `${currentQuestionIdx + 1} / ${quizData.length}`;

            const fb = document.getElementById('feedbackBox');
            fb.classList.add('hidden');
            fb.classList.remove('feedback-anim');

            const nextBtn = document.getElementById('nextBtn');
            nextBtn.disabled = true;
            nextBtn.className = "bg-gray-700 text-gray-400 cursor-not-allowed font-orbitron px-6 py-2.5 rounded-lg font-bold flex items-center space-x-2 transition";

            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';
            const prefixes = ['A', 'B', 'C', 'D'];

            q.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = "option-btn w-full text-left bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-yellow-500/50 p-4 rounded-xl transition duration-200 flex items-start space-x-3 group";
                btn.onclick = () => selectOption(idx);
                btn.innerHTML = `
                    <span class="font-orbitron font-bold text-yellow-400 bg-gray-900 group-hover:bg-yellow-500 group-hover:text-black w-8 h-8 rounded-lg flex items-center justify-center shrink-0 border border-gray-700 transition">
                        ${prefixes[idx]}
                    </span>
                    <span class="text-sm md:text-base text-gray-200 pt-1 leading-snug">${optText}</span>
                `;
                container.appendChild(btn);
            });

            startTimer();
        }

        /* ============================================================
           TIMER
           ============================================================ */
        function startTimer() {
            timer = TIME_PER_Q;

            const bar = document.getElementById('timerBar');
            bar.style.transition = 'none';
            bar.style.width = '100%';
            bar.style.background = 'linear-gradient(to right, #16a34a, #22c55e)';
            void bar.offsetWidth;
            bar.style.transition = 'width 1s linear, background 300ms ease';

            updateTimerUI();

            timerInterval = setInterval(() => {
                timer--;
                updateTimerUI();

                if ([10, 5, 3, 2, 1].includes(timer)) sfx.warn();

                if (timer <= 0) {
                    clearInterval(timerInterval);
                    handleTimeout();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const bar = document.getElementById('timerBar');
            document.getElementById('timerText').textContent = `${timer}s`;
            bar.style.width = `${(timer / TIME_PER_Q) * 100}%`;

            let bg;
            if (timer <= 10) bg = 'linear-gradient(to right, #dc2626, #ef4444)';
            else if (timer <= 20) bg = 'linear-gradient(to right, #d97706, #f59e0b)';
            else bg = 'linear-gradient(to right, #16a34a, #22c55e)';
            bar.style.background = bg;

            const box = document.getElementById('timerBox');
            if (timer <= 10) {
                box.className = "w-10 h-10 bg-red-600 text-white rounded-lg flex items-center justify-center font-bold";
            } else {
                box.className = "w-10 h-10 bg-red-500/20 text-red-400 rounded-lg flex items-center justify-center font-bold";
            }
        }

        /* ============================================================
           ANSWER
           ============================================================ */
        function selectOption(selectedIndex) {
            clearInterval(timerInterval);
            const q = quizData[currentQuestionIdx];
            const buttons = document.querySelectorAll('.option-btn');
            buttons.forEach(btn => btn.disabled = true);

            const isCorrect = (selectedIndex === q.answer);
            const fb = document.getElementById('feedbackBox');

            if (isCorrect) {
                score += 100;
                userAnswers.push({ status: 'correct', chosen: selectedIndex });
                buttons[selectedIndex].className = "w-full text-left bg-green-900/60 border-2 border-green-500 p-4 rounded-xl flex items-start space-x-3 glow-green";

                fb.className = "mt-4 p-4 rounded-xl border-2 flex items-start space-x-3 text-sm feedback-anim border-green-500 bg-green-900/40 text-green-300";
                fb.innerHTML = `<i class="fa-solid fa-circle-check text-lg mt-0.5"></i><div><strong>Correct!</strong> +100 points. Your car moves forward! 🚗💨</div>`;
                fb.classList.remove('hidden');

                sfx.correct();
                updateLiveScore();
                updateCarPosition(true);
            } else {
                userAnswers.push({ status: 'wrong', chosen: selectedIndex });
                buttons[selectedIndex].className = "w-full text-left bg-red-900/60 border-2 border-red-500 p-4 rounded-xl flex items-start space-x-3 glow-red";
                buttons[q.answer].className = "w-full text-left bg-green-900/40 border-2 border-green-500/80 p-4 rounded-xl flex items-start space-x-3";

                const prefixes = ['A', 'B', 'C', 'D'];
                fb.className = "mt-4 p-4 rounded-xl border-2 flex items-start space-x-3 text-sm feedback-anim border-red-500 bg-red-900/40 text-red-300";
                fb.innerHTML = `<i class="fa-solid fa-circle-xmark text-lg mt-0.5"></i><div><strong>Not quite.</strong> The correct answer is <strong>${prefixes[q.answer]}. ${q.options[q.answer]}</strong>. Your car stays still.</div>`;
                fb.classList.remove('hidden');

                sfx.wrong();
            }

            enableNextButton();
        }

        function handleTimeout() {
            const q = quizData[currentQuestionIdx];
            userAnswers.push({ status: 'timeout', chosen: null });

            const buttons = document.querySelectorAll('.option-btn');
            buttons.forEach(btn => btn.disabled = true);
            buttons[q.answer].className = "w-full text-left bg-amber-900/40 border-2 border-amber-500 p-4 rounded-xl flex items-start space-x-3";

            const fb = document.getElementById('feedbackBox');
            const prefixes = ['A', 'B', 'C', 'D'];
            fb.className = "mt-4 p-4 rounded-xl border-2 flex items-start space-x-3 text-sm feedback-anim border-amber-500 bg-amber-900/40 text-amber-300";
            fb.innerHTML = `<i class="fa-solid fa-clock text-lg mt-0.5"></i><div><strong>Time's up!</strong> The correct answer is <strong>${prefixes[q.answer]}. ${q.options[q.answer]}</strong>.</div>`;
            fb.classList.remove('hidden');

            sfx.timeout();
            enableNextButton();
        }

        function enableNextButton() {
            const btn = document.getElementById('nextBtn');
            btn.disabled = false;
            btn.className = "bg-gradient-to-r from-red-600 to-amber-500 hover:from-red-500 hover:to-amber-400 text-white font-orbitron px-6 py-2.5 rounded-lg font-bold flex items-center space-x-2 transition shadow-lg hover:shadow-red-500/40 cursor-pointer";
        }

        function updateLiveScore() {
            document.getElementById('liveScore').textContent = score;
        }

        /* ============================================================
           CAR POSITION — moves on correct answers only
           ============================================================ */
        function updateCarPosition(animate) {
            const correctCount = userAnswers.filter(a => a.status === 'correct').length;
            const pct = (correctCount / quizData.length) * 90;
            const car = document.getElementById('racingCar');
            car.style.left = `${pct}%`;

            if (animate) {
                car.classList.remove('car-vroom');
                void car.offsetWidth;
                car.classList.add('car-vroom');
                setTimeout(() => car.classList.remove('car-vroom'), 800);
            }
        }

        /* ============================================================
           NEXT
           ============================================================ */
        function nextQuestion() {
            currentQuestionIdx++;
            if (currentQuestionIdx < quizData.length) {
                loadQuestion();
            } else {
                showReport();
            }
        }

        /* ============================================================
           REPORT
           ============================================================ */
        function showReport() {
            clearInterval(timerInterval);
            document.getElementById('quizScreen').classList.add('hidden');
            document.getElementById('loginScreen').classList.add('hidden');
            document.getElementById('historyScreen').classList.add('hidden');
            document.getElementById('reportScreen').classList.remove('hidden');

            const total = quizData.length;
            let correctCount = 0, wrongCount = 0, timeoutCount = 0;
            userAnswers.forEach(a => {
                if (a.status === 'correct') correctCount++;
                else if (a.status === 'wrong') wrongCount++;
                else timeoutCount++;
            });

            const percentage = Math.round((correctCount / total) * 100);

            document.getElementById('reportName').textContent = student.name;
            document.getElementById('reportClass').textContent = student.class;
            document.getElementById('reportGrade').textContent = `${percentage}%`;
            document.getElementById('reportCorrect').textContent = correctCount;
            document.getElementById('reportWrong').textContent = wrongCount;
            document.getElementById('reportTimeout').textContent = timeoutCount;
            document.getElementById('reportTotalScore').textContent = `${score} pts`;

            saveResult({
                name: student.name,
                class: student.class,
                score,
                correct: correctCount,
                wrong: wrongCount,
                timeout: timeoutCount,
                total,
                accuracy: percentage,
                date: new Date().toISOString()
            });

            const container = document.getElementById('breakdownContainer');
            container.innerHTML = '';
            const prefixes = ['A', 'B', 'C', 'D'];

            quizData.forEach((q, idx) => {
                const ua = userAnswers[idx];
                let badge;
                if (ua.status === 'correct') badge = `<span class="bg-green-500/20 text-green-400 text-xs px-2.5 py-1 rounded border border-green-500/30 font-bold whitespace-nowrap"><i class="fa-solid fa-check"></i> CORRECT</span>`;
                else if (ua.status === 'wrong') badge = `<span class="bg-red-500/20 text-red-400 text-xs px-2.5 py-1 rounded border border-red-500/30 font-bold whitespace-nowrap"><i class="fa-solid fa-xmark"></i> WRONG</span>`;
                else badge = `<span class="bg-amber-500/20 text-amber-400 text-xs px-2.5 py-1 rounded border border-amber-500/30 font-bold whitespace-nowrap"><i class="fa-solid fa-clock"></i> TIMED OUT</span>`;

                const correctText = `${prefixes[q.answer]}. ${q.options[q.answer]}`;
                const chosenText = ua.chosen !== null ? `${prefixes[ua.chosen]}. ${q.options[ua.chosen]}` : 'None (Time Out)';

                const item = document.createElement('div');
                item.className = "bg-gray-900/90 p-3 rounded-lg border border-gray-700 text-xs space-y-1";
                item.innerHTML = `
                    <div class="flex justify-between items-start gap-2">
                        <span class="font-bold text-gray-300">Q${idx + 1}: ${q.question}</span>
                        ${badge}
                    </div>
                    <div class="text-gray-400 mt-1">
                        <span class="text-green-400 font-semibold">Correct:</span> ${correctText}
                    </div>
                    ${ua.status !== 'correct' ? `<div class="text-gray-400"><span class="text-red-400 font-semibold">Your Answer:</span> ${chosenText}</div>` : ''}
                `;
                container.appendChild(item);
            });

            sfx.finish();
            if (percentage >= 80) launchConfetti();
        }

        /* ============================================================
           STORAGE
           ============================================================ */
        function saveResult(result) {
            try {
                const all = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
                all.push(result);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
            } catch (e) { console.warn("Could not save result:", e); }
        }

        function loadResults() {
            try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); }
            catch (e) { return []; }
        }

        /* ============================================================
           HISTORY SCREEN
           ============================================================ */
        function showHistory(returnTo) {
            historyReturnTo = returnTo || "login";
            document.getElementById('loginScreen').classList.add('hidden');
            document.getElementById('quizScreen').classList.add('hidden');
            document.getElementById('reportScreen').classList.add('hidden');
            document.getElementById('historyScreen').classList.remove('hidden');
            renderHistory();
        }

        function backFromHistory() {
            document.getElementById('historyScreen').classList.add('hidden');
            if (historyReturnTo === "report") {
                document.getElementById('reportScreen').classList.remove('hidden');
            } else {
                document.getElementById('loginScreen').classList.remove('hidden');
            }
        }

        function renderHistory() {
            const all = loadResults().sort((a, b) => new Date(b.date) - new Date(a.date));
            const summary = document.getElementById('historySummary');
            const body = document.getElementById('historyBody');
            const search = (document.getElementById('historySearch').value || "").toLowerCase();

            if (all.length === 0) {
                summary.innerHTML = '';
                body.innerHTML = `
                    <div class="text-center py-12 text-gray-500">
                        <i class="fa-solid fa-folder-open text-5xl mb-3"></i>
                        <p class="text-sm">No results yet. Finish a race to see it here.</p>
                    </div>`;
                return;
            }

            const avgScore = Math.round(all.reduce((s, r) => s + r.score, 0) / all.length);
            const bestScore = Math.max(...all.map(r => r.score));
            summary.innerHTML = `
                <div class="bg-gray-800/80 border border-gray-700 rounded-xl p-4 text-center">
                    <span class="text-xs text-gray-400 block">TOTAL ATTEMPTS</span>
                    <span class="font-orbitron text-2xl font-bold text-blue-400">${all.length}</span>
                </div>
                <div class="bg-gray-800/80 border border-gray-700 rounded-xl p-4 text-center">
                    <span class="text-xs text-gray-400 block">AVG SCORE</span>
                    <span class="font-orbitron text-2xl font-bold text-amber-400">${avgScore}</span>
                </div>
                <div class="bg-gray-800/80 border border-gray-700 rounded-xl p-4 text-center">
                    <span class="text-xs text-gray-400 block">BEST SCORE</span>
                    <span class="font-orbitron text-2xl font-bold text-green-400">${bestScore}</span>
                </div>`;

            const filtered = search
                ? all.filter(r => r.name.toLowerCase().includes(search))
                : all;

            if (filtered.length === 0) {
                body.innerHTML = `<div class="text-center py-8 text-gray-500 text-sm">No student matches "${search}".</div>`;
                return;
            }

            const rows = filtered.map((r, i) => {
                const isYou = student.name && r.name.toLowerCase() === student.name.toLowerCase();
                const accClass = r.accuracy >= 80 ? 'text-green-400' : r.accuracy >= 60 ? 'text-amber-400' : 'text-red-400';
                const d = new Date(r.date);
                const dateStr = d.toLocaleDateString(undefined, { month: "short", day: "numeric" }) + " · " +
                                d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
                return `
                    <tr class="border-b border-gray-800 hover:bg-gray-800/40 transition ${isYou ? 'bg-yellow-500/5' : ''}">
                        <td class="py-2 px-3 text-gray-500 font-bold text-xs">#${i + 1}</td>
                        <td class="py-2 px-3">
                            <span class="font-bold text-gray-200">${escapeHtml(r.name)}</span>
                            ${isYou ? '<span class="ml-2 text-[9px] bg-yellow-500 text-black font-orbitron font-bold px-1.5 py-0.5 rounded">YOU</span>' : ''}
                        </td>
                        <td class="py-2 px-3 text-gray-400 text-xs">${escapeHtml(r.class)}</td>
                        <td class="py-2 px-3 font-orbitron font-bold text-yellow-400">${r.score}</td>
                        <td class="py-2 px-3 text-green-400">${r.correct}/${r.total}</td>
                        <td class="py-2 px-3 font-bold ${accClass}">${r.accuracy}%</td>
                        <td class="py-2 px-3 text-gray-500 text-xs whitespace-nowrap">${dateStr}</td>
                    </tr>`;
            }).join('');

            body.innerHTML = `
                <div class="bg-gray-900/80 rounded-xl border border-gray-700 overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-800 border-b border-gray-700">
                            <tr class="text-xs text-gray-400 uppercase">
                                <th class="text-left py-3 px-3">Rank</th>
                                <th class="text-left py-3 px-3">Student</th>
                                <th class="text-left py-3 px-3">Class</th>
                                <th class="text-left py-3 px-3">Score</th>
                                <th class="text-left py-3 px-3">Correct</th>
                                <th class="text-left py-3 px-3">Accuracy</th>
                                <th class="text-left py-3 px-3">Date</th>
                            </tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>
                <div class="text-center mt-4 text-xs text-gray-500">
                    Showing ${filtered.length} of ${all.length} attempts ·
                    <button onclick="clearHistory()" class="text-red-500 hover:text-red-400 font-bold">Clear all records</button>
                </div>`;
        }

        function clearHistory() {
            if (confirm("Delete all saved results? This cannot be undone.")) {
                localStorage.removeItem(STORAGE_KEY);
                renderHistory();
            }
        }

        /* ============================================================
           CSV EXPORT
           ============================================================ */
        function exportCSV() {
            const all = loadResults();
            if (all.length === 0) {
                alert("No results to export yet.");
                return;
            }
            const header = ["Name","Class","Score","Correct","Wrong","Timeout","Total","Accuracy","Date"];
            const rows = all.map(r => [
                `"${String(r.name).replace(/"/g, '""')}"`,
                `"${String(r.class).replace(/"/g, '""')}"`,
                r.score, r.correct, r.wrong, r.timeout, r.total,
                r.accuracy + "%",
                `"${new Date(r.date).toLocaleString()}"`
            ].join(","));
            const csv = [header.join(","), ...rows].join("\n");
            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "pancasila_race_report_" + new Date().toISOString().slice(0, 10) + ".csv";
            a.click();
            URL.revokeObjectURL(url);
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
        }

        /* ============================================================
           CONFETTI
           ============================================================ */
        function launchConfetti() {
            const canvas = document.getElementById('confetti');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const colors = ["#fbbf24", "#ef4444", "#22c55e", "#3b82f6", "#ec4899", "#f97316"];
            const parts = [];
            for (let i = 0; i < 80; i++) {
                parts.push({
                    x: Math.random() * canvas.width,
                    y: -20 - Math.random() * 200,
                    vx: (Math.random() - 0.5) * 4,
                    vy: Math.random() * 3 + 2,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    rot: Math.random() * Math.PI,
                    vrot: (Math.random() - 0.5) * 0.25
                });
            }
            let frames = 0;
            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                parts.forEach(p => {
                    p.x += p.vx; p.y += p.vy; p.vy += 0.08; p.rot += p.vrot;
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rot);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
                    ctx.restore();
                });
                frames++;
                if (frames < 200) requestAnimationFrame(animate);
                else ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
            animate();
        }

        /* ============================================================
           RESTART
           ============================================================ */
        function restartQuiz() {
            document.getElementById('reportScreen').classList.add('hidden');
            document.getElementById('historyScreen').classList.add('hidden');
            document.getElementById('loginScreen').classList.remove('hidden');
            document.getElementById('userInfoHeader').classList.add('hidden');

            document.getElementById('studentName').value = "";
            document.getElementById('studentClass').value = "";
            student = { name: "", class: "" };
        }

        /* ============================================================
           KEYBOARD SHORTCUT
           ============================================================ */
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const nextBtn = document.getElementById('nextBtn');
                const quizVisible = !document.getElementById('quizScreen').classList.contains('hidden');
                if (quizVisible && nextBtn && !nextBtn.disabled) {
                    e.preventDefault();
                    nextBtn.click();
                }
            }
        });

        /* ============================================================
           INIT
           ============================================================ */
        window.addEventListener('resize', () => {
            if (!document.getElementById('quizScreen').classList.contains('hidden')) {
                updateCarPosition(false);
            }
        });
    </script>
</body>
